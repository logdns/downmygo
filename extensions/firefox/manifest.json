{
  "manifest_version": 3,
  "name": "downmygo",
  "version": "1.0.0",
  "description": "Send links to downmygo, with the cookies the site needs. Videos, galleries and files come down in the app.",
  "homepage_url": "https://logdns.github.io/downmygo/",
  "browser_specific_settings": {
    "gecko": {
      "id": "downmygo@logdns.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "contextMenus",
    "cookies",
    "downloads",
    "storage",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "downmygo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
